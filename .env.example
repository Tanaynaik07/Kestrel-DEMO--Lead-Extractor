# ---- Server ----
PORT=3000

# ---- Security ----
# Set to "true" only if this app runs behind a reverse proxy / PaaS (Render, Vercel,
# Railway, Nginx, etc.) that sets X-Forwarded-For. Leave unset/false for local dev -
# trusting this header without an actual proxy lets clients spoof their IP and bypass
# rate limiting.
TRUST_PROXY=false

# Comma-separated list of origins allowed to POST to /api/lead (e.g. https://kestrel-advisory.com).
# Leave empty to skip the check (fine for local dev / same-origin-only deployments).
ALLOWED_ORIGINS=

# Optional overrides for the built-in limits (sane defaults are used if unset).
MAX_MESSAGE_CHARS=4000
MAX_MESSAGE_WORDS=600
RATE_LIMIT_LEAD_MAX=5
RATE_LIMIT_GLOBAL_MAX=300

# ---- Gemini (Google AI Studio) ----
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---- Google Sheets ----
# 1. Create a Google Cloud project -> enable "Google Sheets API"
# 2. Create a Service Account -> create a JSON key for it
# 3. Share your target Google Sheet with the service account's email
#    (looks like xxxx@xxxx.iam.gserviceaccount.com) as an Editor
SHEET_ID=your_google_sheet_id_here
SHEET_TAB_NAME=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON key file.
# Keep it wrapped in quotes and keep the \n sequences as-is (do not turn them into real line breaks).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---- Outgoing notification email (Gmail SMTP + App Password) ----
# 1. Turn on 2-Step Verification on the Gmail account you want to send FROM:
#    https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (choose "Mail" / "Other", copy the 16-character password it gives you).
# 3. Put that Gmail address in GMAIL_USER and the 16-character password in
#    GMAIL_APP_PASSWORD (spaces in the password are fine, keep it as shown).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# The "From" header on outgoing emails. Should reference the same GMAIL_USER address above.
FROM_EMAIL="Lead Bot <you@gmail.com>"
# Where new-lead notifications are sent — can be a different address
NOTIFY_EMAIL=you@yourbusiness.com
